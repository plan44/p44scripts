// configuration
// - IP address of the dingz
var ip='192.168.x.x'
// - which input
var input="motion_internal"

// http-Requests von Geräten (verbesserte Version 2026-08-16)
on (webrequest(undefined, ip)) as w
{
  log(6, "w = %s", w)
  try {
    if (w.dingz==input) {
      // this is the right input
      var msg = {message:'input', index:0 }
      if (w.state>0) {
        // motion detected
        msg.value = 1
      }
      else {
        // no motion detected
        msg.value = 0
      }
      message(msg)
    }
    // wichtig: webrequest immer beantworten!
    w.answer({ status:"ok" })
  }
  catch as e {
    log(4, "Error during web request processing: %s", e)
    request.answer({ status:"error", message:errormessage(e) })
  }
}


return true;
