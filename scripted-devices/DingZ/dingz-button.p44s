// configuration
// - IP address of the dingz
var ip='192.168.1.123'
// - which button?
var button="button1"

// http-Requests von Geräten (verbesserte Version 2026-08-16)
on (webrequest(undefined, ip)) as w
{
  log(6, "w = %s", w)
  try {
    if (w.dingz==button) {
      // this is the right button
      var msg = {message:'button', index:0 }
      if (w.click==0) {
        // button released
        msg.value = -10
      }
      else if (w.click==5) {
        // button held longer
        msg.value = -11
      }
      else {
        // 1..4-fold click, feed directly (negative value)
        msg.value = -w.click
      }
      message(msg)
    }
    // wichtig: webrequest immer beantworten!
    w.answer({ status:"ok" })
  }
  catch as e {
    log(4, "Error during web request processing: %s", e)
    request.answer({ status:"error", message:errormessage(e) })
  }
}

return true
